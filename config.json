{
    "_dashboard": {
        "_comment": "Optional. If omitted, dashboard auto-generates a password and prints it to stdout on first boot. Set 'password_hash' (pbkdf2_sha256$...) to use a fixed password. Run: python -c \"import dashboard; print(dashboard.hash_password('yourpw'))\" to generate.",
        "password_hash": "",
        "session_secret": ""
    },
    "_global": {
        "_comment": "Optional. Inheritable defaults for every bot. Per-bot values override these.",
        "max_restarts": 5,
        "restart_delay_base": 2.0
    },

    "bot1": {
        "source": "https://github.com/<GitHub Username>/<repo1>.git",
        "run": "main.py",
        "env": {
            "TOKEN": ""
        },
        "enabled": true,
        "max_restarts": 5,
        "restart_delay_base": 2.0,
        "health_url": "",
        "health_timeout": 5.0,
        "args": [],
        "timeout_graceful": 10.0
    },

    "bot2": {
        "source": "https://github.com/<GitHub Username>/<repo2>.git",
        "run": "bot.py",
        "env": {
            "TOKEN": ""
        },
        "enabled": true
    },

    "bot3": {
        "source": "https://<GitHub Username>:<GitHub Token>@github.com/<GitHub Username>/<private-repo>.git",
        "run": "main.py",
        "env": {
            "TOKEN": ""
        },
        "enabled": true
    }
}
