    "log_level": os.environ.get("MB_LOG_LEVEL", "INFO"),
    "log_dir": os.environ.get("MB_LOG_DIR", "logs"),

    "start_delay": float(
        os.environ.get("MB_START_DELAY", "2.0")
    ),

    "max_restarts": int(
        os.environ.get("MB_MAX_RESTARTS", "5")
    ),

