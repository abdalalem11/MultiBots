        os.environ.get("MB_RESTART_DELAY_BASE", "2.0")
    ),

    "restart_delay_max": float(
        os.environ.get("MB_RESTART_DELAY_MAX", "120.0")
    ),

    "watchdog_interval": float(
        os.environ.get("MB_WATCHDOG_INTERVAL", "5.0")
    ),

    "ping_interval": float(
        os.environ.get("MB_PING_INTERVAL", "120.0")
    ),

    "ping_url": os.environ.get(
